{
  "name": "@sriver/devstarter",
  "version": "0.3.1",
  "description": "Un outil CLI pour créer rapidement des projets web avec différents frameworks",
  "main": "DevStarter",
  "bin": {
    "devstarter": "DevStarter"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "scripts": {
    "start": "node DevStarter",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/Integration.test.js",
    "test:unit": "vitest run tests/DesignManager.test.js tests/PackageManagers.test.js",
    "test:ci": "vitest run --coverage --reporter=junit --outputFile=test-results.xml",
    "demo": "echo \"Run 'npm start' to launch DevStarter\""
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "gradient-string": "^3.0.0",
    "prompts": "^2.4.2"
  },
  "files": [
    "DevStarter",
    "Languages.js",
    "PackageManagers.js",
    "src/",
    "locales/",
    "README.md",
    "ROUTING_OPTIONS.md"
  ],
  "keywords": [
    "cli",
    "project",
    "generator",
    "react",
    "vue",
    "svelte",
    "solid",
    "vite",
    "next",
    "create-react-app",
    "typescript"
  ],
  "author": "sriver",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D-Sriver/reactcreator.git"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "execa": "^9.6.0",
    "tmp-promise": "^3.0.3",
    "vitest": "^3.2.4"
  }
}
